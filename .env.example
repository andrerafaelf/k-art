# Copy to .env and fill in. `npm start` and `npm run dev` both read it.

# The first admin account, created on first start while there are no accounts.
# After that, accounts are managed in the admin (My account) and these are ignored.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where content.json, backups/ and uploads/ live. Must survive redeploys,
# so on a host with ephemeral disks point this at a persistent volume.
DATA_DIR=data

# Uploads go through the server, so allow photos up to 8 MB plus some headroom.
BODY_SIZE_LIMIT=10M

PORT=3000

# Before launch: only these IPs or CIDR ranges can open the site, everyone else
# gets a holding page. Needs ADDRESS_HEADER behind a proxy. Unset means open.
# SITE_ALLOW_IPS=203.0.113.7,2001:db8:1234:5678::/64

# Only behind a reverse proxy that talks plain HTTP to this server:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
